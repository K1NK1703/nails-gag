# Личный кабинет: вход в шапке и маршрут /cabinet; false — скрыть
VITE_FEATURE_CABINET=true
# Имя «вошедшего» пользователя — только для просмотра дизайна вошедшего пользователя
VITE_PREVIEW_USER=
# Эндпоинт для событий аналитики; пусто = события не отправляются
VITE_ANALYTICS_ENDPOINT=
# Публичный адрес сайта для canonical, Open Graph и sitemap
VITE_SITE_URL=https://nails-gag.ru
